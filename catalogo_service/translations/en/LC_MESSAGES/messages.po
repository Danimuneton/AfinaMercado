msgid "Este campo es obligatorio."
msgstr "This field is required."

msgid "Debe ser un texto."
msgstr "Must be text."

#, python-format
msgid "Máximo %(n)s caracteres."
msgstr "Maximum %(n)s characters."

msgid "Debe ser un número entero."
msgstr "Must be an integer."

msgid "El campo 'ids' debe ser una lista no vacía."
msgstr "The 'ids' field must be a non-empty list."

msgid "Todos los ids deben ser números enteros."
msgstr "All ids must be integers."

#, python-format
msgid "El instrumento %(id)s no existe."
msgstr "Instrument %(id)s does not exist."

msgid "Datos de vendedor inválidos."
msgstr "Invalid seller data."

msgid "Datos de categoría inválidos."
msgstr "Invalid category data."

msgid "Ya existe una categoría con ese nombre."
msgstr "A category with that name already exists."

msgid "Condición no válida."
msgstr "Invalid condition."

msgid "El precio debe ser mayor que 0."
msgstr "The price must be greater than 0."

msgid "El precio es demasiado alto."
msgstr "The price is too high."

msgid "El precio debe ser numérico."
msgstr "The price must be numeric."

msgid "El vendedor no existe."
msgstr "The seller does not exist."

msgid "La categoría no existe."
msgstr "The category does not exist."

msgid "Datos de instrumento inválidos."
msgstr "Invalid instrument data."

#, python-format
msgid "Instrumentos inexistentes: %(ids)s"
msgstr "Nonexistent instruments: %(ids)s"

#, python-format
msgid "Ya no están disponibles: %(nombres)s"
msgstr "No longer available: %(nombres)s"

msgid "Instrumentos musicales disponibles para la venta"
msgstr "Musical instruments available for sale"

msgid "El cuerpo de la petición debe ser un objeto JSON."
msgstr "The request body must be a JSON object."

msgid "Token de servicio inválido o ausente."
msgstr "Invalid or missing service token."

msgid "Solicitud inválida."
msgstr "Invalid request."

msgid "Recurso no encontrado."
msgstr "Resource not found."

msgid "Método HTTP no permitido en esta ruta."
msgstr "HTTP method not allowed on this route."

msgid "El contenido debe enviarse como JSON."
msgstr "The content must be sent as JSON."

msgid "Error en la solicitud."
msgstr "Request error."

msgid "Ocurrió un error inesperado en el servicio."
msgstr "An unexpected error occurred in the service."

