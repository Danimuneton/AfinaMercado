msgid "El campo 'orden_id' es obligatorio."
msgstr "The 'orden_id' field is required."

msgid "El campo 'orden_id' debe ser un número entero."
msgstr "The 'orden_id' field must be an integer."

msgid "El campo 'monto' es obligatorio."
msgstr "The 'monto' field is required."

msgid "El campo 'monto' debe ser numérico."
msgstr "The 'monto' field must be numeric."

msgid "El campo 'monto' debe ser mayor que 0."
msgstr "The 'monto' field must be greater than 0."

msgid "El campo 'metodo' es obligatorio."
msgstr "The 'metodo' field is required."

#, python-format
msgid "Método '%(metodo)s' no soportado. Válidos: %(validos)s."
msgstr "Method '%(metodo)s' is not supported. Valid: %(validos)s."

msgid "Transacción rechazada por la pasarela (monto sospechoso)."
msgstr "Transaction rejected by the gateway (suspicious amount)."

msgid "La transacción no existe."
msgstr "The transaction does not exist."

msgid "El cuerpo de la petición debe ser un objeto JSON."
msgstr "The request body must be a JSON object."

msgid "Token de servicio inválido o ausente."
msgstr "Invalid or missing service token."

msgid "Solicitud inválida."
msgstr "Invalid request."

msgid "Recurso no encontrado."
msgstr "Resource not found."

msgid "Método HTTP no permitido en esta ruta."
msgstr "HTTP method not allowed on this route."

msgid "El contenido debe enviarse como JSON."
msgstr "The content must be sent as JSON."

msgid "Error en la solicitud."
msgstr "Request error."

msgid "Ocurrió un error inesperado en el servicio."
msgstr "An unexpected error occurred in the service."

