# Copia este archivo como .env (NO subas .env al repositorio) y cambia los valores.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux (EC2):         cp .env.example .env

# Puerto público de Nginx. En AWS usa 80. En tu PC usa 8080 si el 80 está ocupado.
NGINX_PORT=8080

# --- Django ---
DJANGO_DEBUG=False
# Genera una clave larga y aleatoria (ver docs/DESPLIEGUE_AWS.md)
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
# Agrega la IP elástica de AWS separada por comas, ej: localhost,127.0.0.1,3.85.10.20
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Necesario si accedes por un puerto distinto al 80, ej: http://localhost:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Usuario administrador que se crea al arrancar (puede ver Reportes y /admin/)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambia-esta-clave
DJANGO_SUPERUSER_EMAIL=admin@afinamercado.co

# --- Base de datos ---
# Usa solo letras, números, - y _ en la contraseña (va dentro de las URLs de conexión de los microservicios).
POSTGRES_USER=afinamercado
POSTGRES_PASSWORD=cambia-esta-clave-de-bd

# --- Seguridad entre microservicios (token compartido solo por los servicios internos) ---
SERVICE_TOKEN=cambia-este-token-interno

# --- URL pública (para los enlaces de la API pública del catálogo), ej: http://3.85.10.20 ---
PUBLIC_BASE_URL=http://localhost:8080

# --- API de terceros (divisas): exchangerate_api (en línea) o tasa_fija (sin internet) ---
DIVISAS_PROVEEDOR=exchangerate_api

# --- Servicio del equipo aliado (completar cuando el profesor asigne el equipo) ---
ALIADO_NOMBRE=
ALIADO_API_URL=

# --- Notificaciones por correo (opcional). Con ENV_TYPE=DEV se escriben en el log del worker ---
ENV_TYPE=DEV
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
