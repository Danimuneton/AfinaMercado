msgid "Falta la cabecera X-Usuario-Id."
msgstr "The X-Usuario-Id header is missing."

msgid "Escribe una dirección de al menos 5 caracteres."
msgstr "Enter an address of at least 5 characters."

#, python-format
msgid "Máximo %(n)s caracteres."
msgstr "Maximum %(n)s characters."

msgid "Método de pago no válido."
msgstr "Invalid payment method."

msgid "Correo no válido."
msgstr "Invalid email."

msgid "Datos de la orden inválidos."
msgstr "Invalid order data."

msgid "Tu carrito está vacío."
msgstr "Your cart is empty."

#, python-format
msgid "No se pudo procesar el pago: %(detalle)s"
msgstr "The payment could not be processed: %(detalle)s"

#, python-format
msgid "La orden %(id)s no existe."
msgstr "Order %(id)s does not exist."

msgid "Estado de envío no válido."
msgstr "Invalid shipping status."

msgid "Solo se pueden enviar órdenes pagadas."
msgstr "Only paid orders can be shipped."

#, python-format
msgid "El servicio de %(servicio)s no está disponible."
msgstr "The %(servicio)s service is not available."

msgid "Error en un servicio dependiente."
msgstr "Error in a dependent service."

msgid "carrito"
msgstr "cart"

msgid "catálogo"
msgstr "catalog"

msgid "pagos"
msgstr "payments"

msgid "El cuerpo de la petición debe ser un objeto JSON."
msgstr "The request body must be a JSON object."

msgid "Token de servicio inválido o ausente."
msgstr "Invalid or missing service token."

msgid "Solicitud inválida."
msgstr "Invalid request."

msgid "Recurso no encontrado."
msgstr "Resource not found."

msgid "Método HTTP no permitido en esta ruta."
msgstr "HTTP method not allowed on this route."

msgid "El contenido debe enviarse como JSON."
msgstr "The content must be sent as JSON."

msgid "Error en la solicitud."
msgstr "Request error."

msgid "Ocurrió un error inesperado en el servicio."
msgstr "An unexpected error occurred in the service."

msgid "La orden necesita un comprador."
msgstr "The order needs a buyer."

msgid "La orden necesita al menos una línea de compra."
msgstr "The order needs at least one item."

msgid "La orden necesita una dirección de envío."
msgstr "The order needs a shipping address."

