msgid "Falta la cabecera X-Usuario-Id."
msgstr "The X-Usuario-Id header is missing."

msgid "El catálogo no está disponible en este momento."
msgstr "The catalog is not available right now."

#, python-format
msgid "El instrumento %(id)s no existe."
msgstr "Instrument %(id)s does not exist."

msgid "El catálogo respondió con un error."
msgstr "The catalog responded with an error."

msgid "Datos inválidos."
msgstr "Invalid data."

msgid "Debe ser un número entero."
msgstr "Must be an integer."

msgid "Este instrumento ya está en tu carrito."
msgstr "This instrument is already in your cart."

msgid "Este instrumento ya fue vendido."
msgstr "This instrument has already been sold."

msgid "No puedes comprar un instrumento que tú publicaste."
msgstr "You cannot buy an instrument you listed."

msgid "Ese instrumento no está en tu carrito."
msgstr "That instrument is not in your cart."

msgid "El cuerpo de la petición debe ser un objeto JSON."
msgstr "The request body must be a JSON object."

msgid "Token de servicio inválido o ausente."
msgstr "Invalid or missing service token."

msgid "Solicitud inválida."
msgstr "Invalid request."

msgid "Recurso no encontrado."
msgstr "Resource not found."

msgid "Método HTTP no permitido en esta ruta."
msgstr "HTTP method not allowed on this route."

msgid "El contenido debe enviarse como JSON."
msgstr "The content must be sent as JSON."

msgid "Error en la solicitud."
msgstr "Request error."

msgid "Ocurrió un error inesperado en el servicio."
msgstr "An unexpected error occurred in the service."

